@model Order
@inject KruaImDee.Data.AppDb Db
@{
    ViewData["Title"] = "ใบเสร็จ #" + Model.Id;
    var setting = Db.Settings.First();
}
<section class="section receipt document-sheet">
    <header class="document-brand">
        <img src="/images/brand-mark.png" alt="เอาอีก"/>
        <div>
            <h1>@setting.Name</h1>
            <p>@setting.Address<br/>โทร. @setting.Phone</p>
        </div>
    </header>
    <div class="document-title">
        <h2>ใบเสร็จรับเงิน</h2>
        <div>เลขที่ R-@Model.Id.ToString("D6")<br/>วันที่ @Model.Payment!.PaidAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <p>รูปแบบบริการ: @(Model.DiningTable?.Name ?? "รับกลับบ้าน")</p>
    @if (Model.Payment.Refunded)
    {
        <p class="refund-stamp">ยกเลิก / คืนเงินแล้ว</p>
    }
    <table class="receipt-items">
        <thead>
            <tr>
                <th>รายการ</th>
                <th>จำนวน</th>
                <th>ราคา/หน่วย</th>
                <th>รวม (บาท)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @item.Name
                        @if (item.DiscountPercent > 0)
                        {
                            <small>ลด @item.DiscountPercent.ToString("0.##")% จาก @item.OriginalUnitPrice.ToString("N2") บาท</small>
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td>@((item.UnitPrice * item.Quantity).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="receipt-totals">
        <div class="line-item">
            <span>รวมค่าอาหาร</span>
            <span>@Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="line-item">
            <span>ส่วนลด @Model.PromoCode</span>
            <span>@Model.Discount.ToString("N2")</span>
        </div>
        <div class="line-item">
            <span>มูลค่าก่อน VAT</span>
            <span>@((Model.Subtotal - Model.Discount).ToString("N2"))</span>
        </div>
        <div class="line-item">
            <span>VAT @Model.VatRate.ToString("0.##")%</span>
            <span>@Model.VatAmount.ToString("N2")</span>
        </div>
        <div class="total-row">
            <strong>ยอดสุทธิ (บาท)</strong>
            <strong>@Model.Total.ToString("N2")</strong>
        </div>
        <div class="line-item">
            <span>รับเงิน, @(Model.Payment.Method == "Cash" ? "เงินสด" : "โอนเงิน")</span>
            <span>@Model.Payment.Received.ToString("N2")</span>
        </div>
        <div class="line-item">
            <span>เงินทอน</span>
            <span>@Model.Payment.Change.ToString("N2")</span>
        </div>
    </div>
    <div class="document-footer">
        <p>ขอบคุณที่ใช้บริการ เอาอีก</p>
        <small>เอกสารรับเงินของร้าน ไม่ใช่ใบกำกับภาษี</small>
    </div>
    <button class="button wide no-print" onclick="window.print()">พิมพ์ใบเสร็จ</button>
    @if (!Model.Payment.Refunded)
    {
        <a class="button secondary wide no-print" href="/Invoices/Create/@Model.Id">ใบกำกับภาษี</a>
    }
    else if (Db.TaxInvoices.Any(x => x.OrderId == Model.Id))
    {
        <a class="button secondary wide no-print" href="/Invoices/Details/@Model.Id">ดูใบกำกับภาษีเดิม</a>
    }
</section>
