@{
    var refundCountLabel = "แจ้งเตือนคืนเงินที่ยังไม่อ่าน";
    var refundWork = false;
    if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        refundCountLabel = "คำขอคืนเงินรออนุมัติที่ไม่ใช่คำขอของตนเอง";
        refundWork = true;
    }
    else if (User.IsInRole("Accountant"))
    {
        refundCountLabel = "รายการคืนเงินรอรับงานและงานที่ตนรับผิดชอบ";
        refundWork = true;
    }
}
<div class="notifications" data-notifications data-refund-count-label="@refundCountLabel" data-refund-work="@refundWork.ToString().ToLowerInvariant()">
    <button type="button" class="icon-button notification-toggle" data-notification-toggle aria-label="การแจ้งเตือน" aria-expanded="false" aria-controls="notification-panel">
        <partial name="_Icon" model='"bell"'/>
        <span class="notification-badge" data-notification-unread hidden aria-hidden="true"></span>
    </button>
    <section id="notification-panel" class="notification-panel" aria-labelledby="notification-heading" hidden>
        <div class="notification-panel-head">
            <h2 id="notification-heading">การแจ้งเตือน</h2>
            <button type="button" class="notification-text-button" data-notification-read-all>อ่านทั้งหมด</button>
        </div>
        <div class="notification-error" data-notification-error hidden>
            <span>โหลดการแจ้งเตือนไม่สำเร็จ ข้อมูลล่าสุดยังคงแสดงอยู่</span>
            <button type="button" class="notification-text-button" data-notification-retry>ลองอีกครั้ง</button>
        </div>
        <div class="notification-list" data-notification-list>
            <p class="notification-empty">กำลังโหลดการแจ้งเตือน</p>
        </div>
        <a class="notification-view-all" href="/Notifications">ดูทั้งหมด</a>
    </section>
    <div hidden data-notification-token>@Html.AntiForgeryToken()</div>
    <div class="sr-only" data-notification-status role="status" aria-live="polite" aria-atomic="true"></div>
</div>
