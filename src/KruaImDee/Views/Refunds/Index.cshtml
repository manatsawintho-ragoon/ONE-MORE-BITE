@model List<RefundRequest>
@{
    ViewData["Title"] = "รายการคืนเงิน";
    string[] statuses =
    {
        "PendingApproval",
        "Approved",
        "Paying",
        "Completed",
        "Rejected",
        "Withdrawn",
        "Revoked"
    };
}
<div class="section-head">
    <div>
        <h1>รายการคืนเงิน</h1>
        <p>ติดตามคำขอ การอนุมัติ และการคืนเงินจริง</p>
    </div>
</div>
<form class="filter-bar" method="get">
    <label>สถานะ<select name="status">
            <option value="">ทั้งหมด</option>
            @foreach (var status in statuses)
            {
                <option value="@status" selected="@(ViewBag.Status==status)">@RefundService.Label(status)</option>
            }
        </select>
    </label>
    <label>เลขออเดอร์<input name="orderId" type="number" min="1" value="@Context.Request.Query["orderId"]"/>
    </label>
    <button class="button">ค้นหา</button>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>คำขอ</th>
                <th>ออเดอร์</th>
                <th>วันที่ขอ</th>
                <th>ยอดคืน</th>
                <th>สถานะ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var refund in Model)
            {
                <tr>
                    <td>RF-@refund.Id.ToString("D6")</td>
                    <td>
                        <a href="/Orders/Details/@refund.Payment.OrderId">#@refund.Payment.OrderId</a>
                    </td>
                    <td>@BusinessTime.Local(refund.RequestedAtUtc).ToString("dd/MM/yyyy HH:mm")</td>
                    <td>฿@refund.Amount.ToString("N2")</td>
                    <td>
                        <span class="badge">@RefundService.Label(refund.Status)</span>
                    </td>
                    <td>
                        <a class="underline-link" href="/Refunds/Details/@refund.Id">รายละเอียด</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6">ไม่พบคำขอคืนเงินตามเงื่อนไข</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination"/>
