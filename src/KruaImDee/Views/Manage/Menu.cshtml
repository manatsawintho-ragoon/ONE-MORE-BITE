@model List<MenuItem>
@{
    ViewData["Title"] = "จัดการเมนู";
    var editedItem = (MenuItem)ViewBag.Edit;
}
<h1>จัดการเมนู</h1>
<div class="manage-grid">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>เมนู</th>
                    <th>หมวด</th>
                    <th>ราคา</th>
                    <th>สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var menuItem in Model)
                {
                    <tr>
                        <td>
                            <div class="table-food">
                                <img src="@menuItem.ImageUrl" alt=""/>
                                <strong>@menuItem.Name</strong>
                            </div>
                        </td>
                        <td>@menuItem.Category.Name</td>
                        <td>฿@menuItem.Price.ToString("N2")</td>
                        <td>@(menuItem.Active?menuItem.SoldOut?"หมด":"เปิดขาย":"ปิดใช้งาน")</td>
                        <td>
                            <a href="?id=@menuItem.Id" class="red">แก้ไข</a>
                            <form method="post" action="/Manage/Deactivate">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kind" value="Menu"/>
                                <input type="hidden" name="id" value="@menuItem.Id"/>
                                <button class="text-button" data-confirm="ปิดใช้งานเมนูนี้?">ปิดใช้งาน</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <form class="panel" method="post" action="/Manage/SaveMenu" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <h2>@(editedItem.Id==0?"เพิ่มเมนูใหม่":"แก้ไขเมนู")</h2>
        <input name="id" value="@editedItem.Id" type="hidden"/>
        <label>ชื่อเมนู<input name="name" value="@editedItem.Name" required maxlength="120"/>
        </label>
        <label>คำอธิบาย<textarea name="description">@editedItem.Description</textarea>
        </label>
        <div class="form-grid">
            <label>ราคา (บาท)<input name="price" type="number" min="1" step="0.01" value="@editedItem.Price" required/>
            </label>
            <label>หมวดหมู่<select name="categoryId">
                    @foreach (Category category in ViewBag.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id==editedItem.CategoryId)">@category.Name</option>
                    }
                </select>
            </label>
        </div>
        <label>ส่วนลดเมนู (%)<input name="discountPercent" type="number" min="0" max="100" step="0.01" value="@editedItem.DiscountPercent" placeholder="เช่น 10"/>
        </label>
        <p class="field-help">ลดราคาเมนูนี้อัตโนมัติ กรอก 0 หากไม่มีส่วนลด</p>
        <label>URL รูปภาพ<input name="imageUrl" value="@editedItem.ImageUrl" placeholder="https://"/>
        </label>
        <label>หรืออัปโหลดรูป<input name="image" type="file" accept="image/jpeg,image/png,image/webp"/>
        </label>
        <small>JPEG, PNG, WebP ไม่เกิน 5 MB</small>
        <label class="check">
            <input type="checkbox" name="active" value="true" checked="@editedItem.Active"/> เปิดใช้งาน</label>
        <label class="check">
            <input type="checkbox" name="soldOut" value="true" checked="@editedItem.SoldOut"/> หมดชั่วคราว</label>
        <button class="button wide">บันทึกเมนู</button>
        <a class="back-link" href="/Manage/Menu">เพิ่มรายการใหม่</a>
    </form>
</div>
<partial name="_Pagination"/>
