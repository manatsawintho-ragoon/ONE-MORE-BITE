# Publish only the application, startup files, clean database and report.
/*
!/.gitignore
!/README.md
!/START.cmd
!/START.ps1
!/runtime.json
!/ONE-MORE-BITE.sln
!/src/
!/database/
!/docs/
/scripts/
/tests/
/database/*
!/database/restaurant.db
!/database/ONE-MORE-BITE.sql
/docs/*
!/docs/report/
/docs/report/*
!/docs/report/67091885-ONE-MORE-BITE.pdf
!/docs/report/67091885-ONE-MORE-BITE.docx
**/bin/
**/obj/
**/App_Data/
**/uploads/
**/Properties/launchSettings.json
**/appsettings.Development.json
**/appsettings.Local.json
**/*.user
**/*.log
**/*.pfx
**/*.pem
**/.DS_Store
